{
  "name": "sendfile",
  "version": "2.0.0",
  "main": "electron/main.js",
  "description": "局域网文件快传 - 支持扫码、断点续传、聊天、批量下载等全功能",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n server,web -c blue,green \"cross-env PORT=3001 STRICT_PORT=1 nodemon server/index.js\" \"cross-env VITE_DEV_API_TARGET=http://localhost:3001 VITE_WS_URL=ws://localhost:3001 vite --host 0.0.0.0\"",
    "dev:server": "cross-env PORT=3001 STRICT_PORT=1 nodemon server/index.js",
    "dev:web": "cross-env VITE_DEV_API_TARGET=http://localhost:3001 VITE_WS_URL=ws://localhost:3001 vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite build && node server/index.js",
    "electron": "npm run build && electron electron/main.js",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "dist": "npm run electron:dist"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "archiver": "^7.0.1",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "express": "^5.2.1",
    "ip": "^2.0.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.3",
    "cross-env": "^10.1.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.sendfile.lan",
    "productName": "SendFile",
    "asar": true,
    "files": [
      "electron/main.js",
      "server/index.js",
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "uploads",
        "to": "uploads",
        "filter": [
          ".gitkeep"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
