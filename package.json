{
  "name": "sendfile",
  "version": "2.0.0",
  "main": "main.js",
  "description": "局域网文件快传 - 支持扫码、断点续传、聊天、批量下载等全功能",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron main.js",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "element-plus": "^2.13.6",
    "express": "^5.2.1",
    "ip": "^2.0.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.sendfile.lan",
    "productName": "SendFile",
    "asar": true,
    "files": [
      "main.js",
      "server.js",
      "index.html",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "uploads",
        "to": "uploads",
        "filter": [
          ".gitkeep"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}