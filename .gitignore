# 依赖包（通过 npm install 安装）
node_modules/

# 上传文件目录（运行时生成，不追踪用户文件）
uploads/*
!uploads/.gitkeep
uploads/.chunks/

# 打包产物（Vite + Electron Builder）
dist/
release/
out/
build/win-unpacked/
build/mac/
build/linux-unpacked/

# Vite 缓存与构建
.vite/
.cache/
dist-ssr/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
*.log

# 环境变量
.env
.env.local
.env.*.local
.npmrc

# Electron builder 缓存
.electron-builder-cache/
electron-builder.yml

# 临时文件
*.tmp
*.temp
*.bak
!index.html.bak

# OS 相关
$RECYCLE.BIN/

# 测试覆盖率
coverage/
.nyc_output/

# 类型定义缓存
*.tsbuildinfo

# pnpm
pnpm-lock.yaml
node_modules/.pnpm/
