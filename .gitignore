# 依赖包（通过 npm install 安装）
node_modules/

# 上传文件目录（运行时生成，不追踪用户文件）
uploads/*
!uploads/.gitkeep
uploads/.chunks/

# 打包产物（Electron Builder）
dist/
out/
build/win-unpacked/
build/mac/
build/linux-unpacked/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
*.log

# 环境变量
.env
.env.local
.env.*.local

# Electron builder 缓存
.electron-builder-cache/

# 临时文件
*.tmp
*.temp
.cache/
